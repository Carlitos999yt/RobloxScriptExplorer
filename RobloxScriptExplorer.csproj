<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Version & Assembly Metadata -->
    <ApplicationTitle>Roblox Script Explorer</ApplicationTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ProductVersion>1.0.0</ProductVersion>
    <Authors>Carlitos999yt</Authors>
    <Company>Carlitos999yt</Company>
    <Product>Roblox Script Explorer</Product>
    <Description>Herramienta y librería C# para explorar, editar y exportar scripts de Roblox Studio.</Description>
    <Copyright>Copyright © 2026 Carlitos999yt</Copyright>
    <NeutralLanguage>es</NeutralLanguage>

    <!-- RAM & Performance Optimizations -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>

    <!-- Clean Standalone Packaging (Without suspicious compressed overlays) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>

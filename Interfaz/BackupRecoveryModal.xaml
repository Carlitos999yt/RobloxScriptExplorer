<Window x:Class="RobloxScriptExplorer.Interfaz.BackupRecoveryModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centro de Recuperación de Backups" Height="480" Width="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0B0F19" Foreground="#F8FAFC" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- System Selection Overrides (NEVER TURN WHITE) -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0284C7"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0369A1"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>

        <!-- Custom Dark ScrollBar Styles -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="#0F172A">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#334155" CornerRadius="5" Margin="2"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="true">
                                                                <Setter Property="Background" Value="#0284C7"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="true">
                                                                <Setter Property="Background" Value="#38BDF8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="#0F172A">
                                    <Track x:Name="PART_Track" IsDirectionReversed="false">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#334155" CornerRadius="5" Margin="2"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="true">
                                                                <Setter Property="Background" Value="#0284C7"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="true">
                                                                <Setter Property="Background" Value="#38BDF8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Column Header Style (Roblox Studio Dark Theme) -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Row Style -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#1F2937"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0369A1"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Cell Style -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0369A1"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🛡️" FontSize="20" Margin="0,0,8,0"/>
                <TextBlock Text="Copias de Seguridad (Backups de Roblox Studio)" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
            </StackPanel>
            <TextBlock Text="Guarda automáticamente las últimas 5 versiones antes de modificar. Las más antiguas se reemplazan solas."
                       Foreground="#94A3B8" FontSize="12.5" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Backups List Table (Dark Studio Theme) -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="4">
            <DataGrid x:Name="GridBackups" Background="#0B0F19" Foreground="#F8FAFC"
                      BorderBrush="#334155" BorderThickness="0" RowBackground="#111827" AlternatingRowBackground="#0F172A"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2937"
                      HeadersVisibility="Column" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha y Hora" Binding="{Binding TimeFormatted}" Width="160" FontWeight="Bold" Foreground="#38BDF8"/>
                    <DataGridTextColumn Header="Mapa / Lugar" Binding="{Binding PlaceName}" Width="170" Foreground="#FFFFFF"/>
                    <DataGridTextColumn Header="Tamaño" Binding="{Binding SizeFormatted}" Width="110" Foreground="#A78BFA" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Archivo de Respaldo" Binding="{Binding FileName}" Width="*" Foreground="#94A3B8"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom Actions -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="BtnOpenFolder" Content="📂 Abrir Carpeta de Backups" Background="#334155" Foreground="#F8FAFC"
                    FontWeight="SemiBold" Padding="14,9" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand" Click="BtnOpenFolder_Click">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnRestore" Content="🔄 Restaurar este Backup" Background="#0D9488" Foreground="#FFFFFF"
                        FontWeight="Bold" Padding="18,9" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnRestore_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
                <Button x:Name="BtnClose" Content="Cerrar" Background="#475569" Foreground="#F8FAFC"
                        FontWeight="SemiBold" Padding="16,9" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
